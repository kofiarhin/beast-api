# Beast API — local configuration. Copy to .env and fill in locally.
# Never commit .env. Never copy secrets from other applications.

# HTTP port (Beast always binds to 127.0.0.1 only)
PORT=3100

# Linear personal API key (used to fetch issues and post comments). Optional for local testing.
LINEAR_API_KEY=
# Linear webhook signing secret. Webhooks are rejected while this is empty.
LINEAR_WEBHOOK_SECRET=

# Only issues carrying this label are executed
BEAST_READY_LABEL=Beast Ready

# Coding agent adapter: codex (claude planned)
BEAST_AGENT=codex

# Optional overrides (defaults shown)
# BEAST_DATA_DIR=./data
# BEAST_PROJECTS_FILE=./config/projects.json
# BEAST_WORKSPACE_ROOT=/home/ubuntu/projects
# BEAST_AGENT_TIMEOUT_MS=3600000
# BEAST_VERIFY_TIMEOUT_MS=600000
# BEAST_VERIFY_SCRIPTS=test,lint,typecheck,build
# BEAST_WEBHOOK_TOLERANCE_MS=60000
# BEAST_CODEX_BIN=codex
# BEAST_CODEX_MODEL=
# LINEAR_API_URL=https://api.linear.app/graphql
